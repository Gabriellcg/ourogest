# Copie para .env.local e ajuste os valores.

# Banco de dados (os mesmos valores do docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=ourogest

# Chave que criptografa o cookie de sessão: mínimo de 32 caracteres, aleatória.
# Para gerar uma:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: WhatsApp do suporte (só números, com DDI e DDD) para o botão da tela /assinatura
NEXT_PUBLIC_SUPORTE_WHATSAPP=
